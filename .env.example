PORT=4001
PORT_SOCKET=4002
# BASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database
BASE_URL=mongodb://127.0.0.1:27017/UpNext
JWT_SECRET=dummy_jwt_secret
NODE_ENV=example
ADMIN_ACCESS_TOKEN=dummy_ADMIN_ACCESS_TOKEN
#testing acc dummyemail@example.com
SENDGRID_API_KEY=SG.dummy_sendgrid_api_key
SENDGRID_SENDER_EMAIL=your_verified_sender_email@example.com
AWS_EMAIL_SECRET_ID=dummy_aws_email_secret_id
AWS_EMAIL_SECRET_KEY=dummy_aws_email_secret_key
AWS_EMAIL_REGION=us-east-1
AWS_SENDER_EMAIL=no-reply@example.com
AWS_PINPOINT_APP_ID=dummy_aws_pinpoint_app_id
AWS_PINPOINT_SENDER_ID=dummy_aws_pinpoint_sender_id
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=dummy_aws_s3_access_key_id
AWS_S3_SECRET_ACCESS_KEY=dummy_aws_s3_secret_access_key
S3_BUCKET_NAME=dummy_s3_bucket_name
S3_BASE_URL=https://dummybucket.s3.us-east-1.amazonaws.com
SUPPORT_EMAIL=supportemail@gmail.com

# Media thumbnails ship with their own ffmpeg binary (@ffmpeg-installer/ffmpeg);
# set this only to point at an ffmpeg that is already installed on the host.
# Leave it unset unless the bundled binary is unavailable — without a working
# ffmpeg, image thumbnails still generate but videos come back with none.
#FFMPEG_PATH=/usr/bin/ffmpeg


#increment this to trigger bootstrap again
BOOTSTRAP_VERSION=1
#BOOTSTRAP STARTUP USERS
BOOTSTRAP_GUEST_EMAIL=guest@UpNext.com
BOOTSTRAP_GUEST_PASSWORD=123456

BOOTSTRAP_ADMIN_EMAIL=admin@UpNext.com
BOOTSTRAP_ADMIN_PASSWORD=Boiler@Adm!n

# AI (provider-agnostic — see backend/services/ai). Swapping provider/model
# later only means changing these + adding a provider adapter file; feature
# code never talks to a provider SDK directly.
AI_PROVIDER=anthropic
AI_TEXT_MODEL=claude-sonnet-5
AI_VISION_MODEL=claude-sonnet-5
AI_API_KEY=dummy_ai_api_key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Set to "true" to skip Stripe Connect onboarding checks in local testing
STRIPE_ONBOARDING_BYPASS=false

# Firebase Admin (push notifications) — no key file on disk any more.
# Either the whole service-account JSON in one line, base64-encoded (preferred:
# no quoting or newline escaping needed):
FIREBASE_SERVICE_ACCOUNT=
# …or just the three fields the SDK needs. Keep the \n escapes in the key and
# wrap it in double quotes:
#FIREBASE_PROJECT_ID=up-next-bookings
#FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@up-next-bookings.iam.gserviceaccount.com
#FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Google Routes API key (computeRouteMatrix). When set, every distanceKm in an
# API response is upgraded from straight-line to the shorter of its driving and
# walking road distance, and tagged with distanceMode. Leave blank to keep the
# straight-line haversine distances and make no external calls.
GOOGLE_MAPS_API_KEY=
# How far a walking route may run before only driving is considered (km).
# Without a ceiling the "lowest of the two" is walking almost every time, since
# pedestrian routes are shorter — Google will return a 178 km walk across a
# border it won't give driving directions for. Defaults to 2.
ROUTE_WALKING_MAX_KM=2
